{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "source_chunks",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chunk_id",
    "section_id",
    "document_id",
    "source_id",
    "source_type",
    "field_name",
    "text",
    "chunk_hash",
    "provenance_json",
    "layer2_run_id",
    "chunk_index",
    "char_start",
    "char_end",
    "word_count",
    "overlap_word_count"
  ],
  "properties": {
    "chunk_id": {
      "type": "string"
    },
    "section_id": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "PROJECT",
        "ARTICLE"
      ]
    },
    "field_name": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "chunk_hash": {
      "type": "string"
    },
    "provenance_json": {
      "type": "string"
    },
    "layer2_run_id": {
      "type": "string"
    },
    "chunk_index": {
      "type": "integer",
      "minimum": 0
    },
    "char_start": {
      "type": "integer",
      "minimum": 0
    },
    "char_end": {
      "type": "integer",
      "minimum": 0
    },
    "word_count": {
      "type": "integer",
      "minimum": 0
    },
    "overlap_word_count": {
      "type": "integer",
      "minimum": 0
    }
  }
}
