{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "SUPPORTED"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "minItems": 1
          },
          "support_strength": {
            "enum": [
              3,
              4
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "INSUFFICIENT_EVIDENCE"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "support_strength": {
            "enum": [
              1,
              2
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "NOT_SUPPORTED"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "support_strength": {
            "enum": [
              0
            ]
          }
        }
      }
    }
  ],
  "properties": {
    "decision": {
      "enum": [
        "SUPPORTED",
        "INSUFFICIENT_EVIDENCE",
        "NOT_SUPPORTED"
      ]
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "enum": [
              "title",
              "keywords",
              "summary",
              "methodology",
              "objectives",
              "expected_results"
            ]
          },
          "text": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "field",
          "text"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "explanation": {
      "minLength": 1,
      "type": "string"
    },
    "support_strength": {
      "maximum": 4,
      "minimum": 0,
      "type": "integer"
    },
    "supported_key_elements": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "decision",
    "support_strength",
    "supported_key_elements",
    "evidence",
    "explanation"
  ],
  "title": "PROJECT_INDICATOR_ASSESSMENT_V1 provider response; no confidence",
  "type": "object"
}
