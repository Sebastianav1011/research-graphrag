{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "indicators": {
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "decision": {
                  "const": "SUPPORTED"
                }
              },
              "required": [
                "decision"
              ]
            },
            "then": {
              "properties": {
                "support_strength": {
                  "enum": [
                    3,
                    4
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "decision": {
                  "const": "INSUFFICIENT_EVIDENCE"
                }
              },
              "required": [
                "decision"
              ]
            },
            "then": {
              "properties": {
                "support_strength": {
                  "enum": [
                    1,
                    2
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "decision": {
                  "const": "NOT_SUPPORTED"
                }
              },
              "required": [
                "decision"
              ]
            },
            "then": {
              "properties": {
                "support_strength": {
                  "enum": [
                    0
                  ]
                }
              }
            }
          },
          {
            "else": {
              "properties": {
                "confidence_raw_score": {
                  "type": "null"
                },
                "corroboration_score": {
                  "type": "null"
                },
                "field_relevance_score": {
                  "type": "null"
                },
                "key_element_coverage": {
                  "type": "null"
                },
                "support_strength_score": {
                  "type": "null"
                }
              }
            },
            "if": {
              "properties": {
                "confidence_status": {
                  "const": "COMPUTED"
                }
              }
            },
            "then": {
              "properties": {
                "confidence_raw_score": {
                  "type": "number"
                },
                "corroboration_score": {
                  "type": "number"
                },
                "field_relevance_score": {
                  "type": "number"
                },
                "key_element_coverage": {
                  "type": "number"
                },
                "support_strength_score": {
                  "type": "number"
                }
              }
            }
          },
          {
            "else": {
              "properties": {}
            },
            "if": {
              "properties": {
                "confidence_status": {
                  "const": "INVALID_ASSESSMENT"
                }
              }
            },
            "then": {
              "properties": {}
            }
          },
          {
            "if": {
              "properties": {
                "decision": {
                  "enum": [
                    "NOT_SUPPORTED",
                    "INSUFFICIENT_EVIDENCE"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "confidence_raw_score": {
                  "type": "null"
                },
                "confidence_status": {
                  "enum": [
                    "NOT_APPLICABLE",
                    "INVALID_ASSESSMENT"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "confidence_status": {
                  "const": "COMPUTED"
                }
              }
            },
            "then": {
              "properties": {
                "decision": {
                  "const": "SUPPORTED"
                },
                "evidence_texts": {
                  "minItems": 1
                },
                "supported_key_elements": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "decision": {
                  "const": "SUPPORTED"
                }
              }
            },
            "then": {
              "properties": {
                "confidence_status": {
                  "enum": [
                    "COMPUTED",
                    "NOT_COMPUTABLE",
                    "INVALID_ASSESSMENT"
                  ]
                }
              }
            }
          }
        ],
        "properties": {
          "assessment_engine": {
            "minLength": 1,
            "type": "string"
          },
          "assessment_engine_status": {
            "minLength": 1,
            "type": "string"
          },
          "confidence_level": {
            "type": "null"
          },
          "confidence_probability": {
            "type": "null"
          },
          "confidence_raw_score": {
            "description": "Decimal quantized to 0.01 using ROUND_HALF_UP; serialize as a JSON number at the transport boundary.",
            "maximum": 100,
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          },
          "confidence_status": {
            "enum": [
              "COMPUTED",
              "NOT_APPLICABLE",
              "NOT_COMPUTABLE",
              "INVALID_ASSESSMENT"
            ]
          },
          "confidence_version": {
            "const": "RAW_CONFIDENCE_V1"
          },
          "corroboration_score": {
            "maximum": 1,
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          },
          "decision": {
            "enum": [
              "SUPPORTED",
              "INSUFFICIENT_EVIDENCE",
              "NOT_SUPPORTED"
            ]
          },
          "evidence_explanation": {
            "minLength": 1,
            "type": "string"
          },
          "evidence_source_fields": {
            "items": {
              "enum": [
                "title",
                "keywords",
                "summary",
                "methodology",
                "objectives",
                "expected_results"
              ]
            },
            "type": "array"
          },
          "evidence_texts": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "field_relevance_score": {
            "maximum": 1,
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          },
          "indicator_category": {
            "minLength": 1,
            "type": "string"
          },
          "indicator_dimension": {
            "type": [
              "string",
              "null"
            ]
          },
          "indicator_id": {
            "minLength": 1,
            "type": "string"
          },
          "indicator_name": {
            "minLength": 1,
            "type": "string"
          },
          "key_element_coverage": {
            "maximum": 1,
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          },
          "project_id": {
            "minLength": 1,
            "type": "string"
          },
          "support_strength": {
            "maximum": 4,
            "minimum": 0,
            "type": "integer"
          },
          "support_strength_score": {
            "maximum": 1,
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          },
          "supported_key_elements": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "project_id",
          "indicator_id",
          "indicator_name",
          "indicator_category",
          "evidence_explanation",
          "assessment_engine",
          "assessment_engine_status",
          "indicator_dimension",
          "decision",
          "support_strength",
          "supported_key_elements",
          "evidence_source_fields",
          "evidence_texts",
          "confidence_version",
          "confidence_status",
          "key_element_coverage",
          "field_relevance_score",
          "corroboration_score",
          "support_strength_score",
          "confidence_raw_score",
          "confidence_probability",
          "confidence_level"
        ],
        "title": "PROJECT_INDICATOR_V1",
        "type": "object"
      },
      "type": "array"
    },
    "metadata": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "assessment_engine": {
          "minLength": 1,
          "type": "string"
        },
        "assessment_engine_status": {
          "minLength": 1,
          "type": "string"
        },
        "assessment_indicator_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "assessment_indicator_version": {
          "minLength": 1,
          "type": "string"
        },
        "candidate_limit_per_project": {
          "const": 2
        },
        "confidence_is_probability": {
          "const": false
        },
        "confidence_version": {
          "const": "RAW_CONFIDENCE_V1"
        },
        "country_internal_code": {
          "const": "000"
        },
        "country_internal_code_system": {
          "const": "INTERNAL"
        },
        "dane_reference_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "type": "string"
        },
        "layer3_run": {
          "minLength": 1,
          "type": "string"
        },
        "output_status": {
          "enum": [
            "PREPARED_NOT_EXECUTED",
            "SYNTHETIC_TEST",
            "PRELIMINARY",
            "FINAL"
          ]
        },
        "planned_project_count": {
          "minimum": 0,
          "type": "integer"
        },
        "project_count": {
          "minimum": 0,
          "type": "integer"
        },
        "retrieval_indicator_version": {
          "minLength": 1,
          "type": "string"
        },
        "territory_ambiguous_mentions": {
          "minimum": 0,
          "type": "integer"
        },
        "territory_ambiguous_projects": {
          "minimum": 0,
          "type": "integer"
        },
        "territory_version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "output_status",
        "project_count",
        "candidate_limit_per_project",
        "layer3_run",
        "retrieval_indicator_version",
        "assessment_indicator_version",
        "assessment_indicator_sha256",
        "assessment_engine",
        "assessment_engine_status",
        "confidence_version",
        "confidence_is_probability",
        "territory_version",
        "dane_reference_sha256",
        "country_internal_code",
        "country_internal_code_system",
        "generated_at"
      ],
      "title": "LAYER4_EXPORT_METADATA_V1",
      "type": "object"
    },
    "projects": {
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "expected_results": {
            "type": [
              "string",
              "null"
            ]
          },
          "keywords": {
            "oneOf": [
              {
                "type": [
                  "string",
                  "null"
                ]
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "methodology": {
            "type": [
              "string",
              "null"
            ]
          },
          "objectives": {
            "type": [
              "string",
              "null"
            ]
          },
          "project_id": {
            "minLength": 1,
            "type": "string"
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "project_id",
          "title",
          "keywords",
          "summary",
          "methodology",
          "objectives",
          "expected_results"
        ],
        "title": "PROJECT_EXPORT_V1",
        "type": "object"
      },
      "type": "array"
    },
    "territories": {
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "allOf": [
          {
            "else": {
              "properties": {
                "code_system": {
                  "const": "DANE"
                },
                "department_code": {
                  "pattern": "^[0-9]{2}$",
                  "type": "string"
                },
                "department_name": {
                  "minLength": 1,
                  "type": "string"
                }
              }
            },
            "if": {
              "properties": {
                "territory_type": {
                  "const": "COUNTRY"
                }
              }
            },
            "then": {
              "properties": {
                "code_system": {
                  "const": "INTERNAL"
                },
                "department_code": {
                  "type": "null"
                },
                "department_name": {
                  "type": "null"
                },
                "territory_code": {
                  "const": "000"
                },
                "territory_name": {
                  "const": "Colombia"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "territory_type": {
                  "const": "DEPARTMENT"
                }
              }
            },
            "then": {
              "properties": {
                "territory_code": {
                  "pattern": "^[0-9]{2}$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "territory_type": {
                  "const": "MUNICIPALITY"
                }
              }
            },
            "then": {
              "properties": {
                "territory_code": {
                  "pattern": "^[0-9]{5}$"
                }
              }
            }
          }
        ],
        "properties": {
          "code_system": {
            "enum": [
              "DANE",
              "INTERNAL"
            ]
          },
          "department_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "department_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "project_id": {
            "minLength": 1,
            "type": "string"
          },
          "territory_code": {
            "minLength": 1,
            "type": "string"
          },
          "territory_name": {
            "minLength": 1,
            "type": "string"
          },
          "territory_type": {
            "enum": [
              "COUNTRY",
              "DEPARTMENT",
              "MUNICIPALITY"
            ]
          }
        },
        "required": [
          "project_id",
          "territory_type",
          "territory_code",
          "territory_name",
          "department_code",
          "department_name",
          "code_system"
        ],
        "title": "PROJECT_TERRITORY_CONSUMPTION_V1",
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "projects",
    "indicators",
    "territories",
    "metadata"
  ],
  "title": "LAYER4_WORKBOOK_DATA_V1",
  "type": "object"
}
