{
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "indicator_id": {
            "type": "string",
            "minLength": 1
          },
          "assessment_version": {
            "const": "ASSESSMENT_V3",
            "type": "string"
          },
          "decision": {
            "type": "string",
            "enum": [
              "SUPPORTED",
              "INSUFFICIENT_EVIDENCE",
              "NOT_SUPPORTED"
            ]
          },
          "support_strength": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "criterion_assessments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "criterion_id": {
                  "type": "string",
                  "minLength": 1
                },
                "support": {
                  "type": "string",
                  "enum": [
                    "CLEAR",
                    "PARTIAL",
                    "NOT_DEMONSTRATED"
                  ]
                },
                "evidence_indices": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "explanation": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "criterion_id",
                "support",
                "evidence_indices",
                "explanation"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "enum": [
                    "title",
                    "keywords",
                    "summary",
                    "methodology",
                    "objectives",
                    "expected_results"
                  ]
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "stage": {
                  "type": "string",
                  "enum": [
                    "ACTIVITY_PROPOSED",
                    "ACTIVITY_EXECUTED",
                    "RESULT_EXPECTED",
                    "RESULT_DEMONSTRATED",
                    "CONTEXT",
                    "DESIGN_DOCUMENTED",
                    "MECHANISM_ESTABLISHED"
                  ]
                }
              },
              "required": [
                "field",
                "text",
                "stage"
              ],
              "additionalProperties": false
            }
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "indicator_id",
          "assessment_version",
          "decision",
          "support_strength",
          "criterion_assessments",
          "evidence",
          "explanation"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "project_id",
    "assessments"
  ],
  "additionalProperties": false
}
