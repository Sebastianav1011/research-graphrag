# Local environment and recreatable tooling caches
.venv/
.venv-*/
venv/
.aws/
.ssh/
credentials*.json
*.key
*.p12
*.pfx
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.uv-cache/
uv.toml
node_modules/
.tmp/
*.tmp
.layer1.lock

# Regenerable local coverage reports; acceptance reports keep their own paths
.coverage
.coverage.*
/htmlcov/
/coverage.xml

# Operating system generated metadata
.DS_Store
Thumbs.db

# Secrets and local input mappings
.env
.env.*
!.env.example
config/sources.yaml
config/*.local.yaml
config/*.local.json
/resultados/

# Institutional data; only documented static synthetic test fixtures are shared
data/**
# El usuario autorizo compartir exclusivamente este contrato de tesis.
!data/contratos/
!data/contratos/tesis_comparacion_30.v1.json
!data/layer1_sources/
!data/templates/
!data/templates/plantilla_entrada_proyectos.xlsx
!data/templates/plantilla_resultado_final_indicadores_territorios.xlsx
!data/templates/resultado_final_indicadores.xlsx
!data/layer1_sources/README.md
!data/layer1_sources/base/
!data/layer1_sources/incoming/
!data/layer1_sources/reference/
!data/layer1_sources/*/.gitkeep
# Only the known public synthetic fixtures are shareable; deliveries stay private.
tests/fixtures/**
!tests/fixtures/synthetic/
!tests/fixtures/synthetic/*.csv
!tests/fixtures/synthetic/README.md
!tests/fixtures/prueba_controlada/
!tests/fixtures/prueba_controlada/README.md
!tests/fixtures/prueba_en_vivo/
!tests/fixtures/prueba_en_vivo/README.md
# Results stay local; only the curated Layer 4 navigation is shared.
/outputs/*
!/outputs/layer4/
/outputs/layer4/*
!/outputs/layer4/README.md
!/outputs/layer4/pruebas/
!/outputs/layer4/performance/
!/outputs/layer4/territorios/
!/outputs/layer4/auditoria/
/outputs/layer4/pruebas/*
!/outputs/layer4/pruebas/README.md
!/outputs/layer4/pruebas/piloto_v2/
!/outputs/layer4/pruebas/validacion_v3_3/
/outputs/layer4/pruebas/piloto_v2/*
!/outputs/layer4/pruebas/piloto_v2/README.md
/outputs/layer4/pruebas/validacion_v3_3/*
!/outputs/layer4/pruebas/validacion_v3_3/README.md
/outputs/layer4/performance/*
!/outputs/layer4/performance/README.md
/outputs/layer4/territorios/*
!/outputs/layer4/territorios/README.md
/outputs/layer4/auditoria/*
!/outputs/layer4/auditoria/README.md

# Local recovery archives are not source or published deliverables.
/archives/

