# Local environment and recreatable tooling caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
node_modules/
.tmp/
*.tmp
.layer1.lock

# Regenerable local coverage reports; acceptance reports keep their own paths
.coverage
.coverage.*
/htmlcov/
/coverage.xml

# Operating system generated metadata
.DS_Store
Thumbs.db

# Secrets and local input mappings
.env
.env.*
!.env.example
config/sources.yaml
config/*.local.yaml

# Institutional data; only documented static synthetic test fixtures are shared
data/**
!data/raw/
!data/raw/README.md
!data/samples/
!data/samples/synthetic/
!data/samples/synthetic/*.csv
!data/samples/synthetic/README.md
# Results stay local; only the curated Layer 4 navigation is shared.
/outputs/*
!/outputs/layer4/
/outputs/layer4/*
!/outputs/layer4/README.md
!/outputs/layer4/pruebas/
!/outputs/layer4/performance/
!/outputs/layer4/territorios/
!/outputs/layer4/auditoria/
/outputs/layer4/pruebas/*
!/outputs/layer4/pruebas/README.md
!/outputs/layer4/pruebas/piloto_v2/
!/outputs/layer4/pruebas/validacion_v3_3/
/outputs/layer4/pruebas/piloto_v2/*
!/outputs/layer4/pruebas/piloto_v2/README.md
/outputs/layer4/pruebas/validacion_v3_3/*
!/outputs/layer4/pruebas/validacion_v3_3/README.md
/outputs/layer4/performance/*
!/outputs/layer4/performance/README.md
/outputs/layer4/territorios/*
!/outputs/layer4/territorios/README.md
/outputs/layer4/auditoria/*
!/outputs/layer4/auditoria/README.md

# Local recovery archives are not source or published deliverables.
/archives/

# Private model/vector/table payloads and interrupted transfers
*.log
*.npy
*.npz
*.parquet
*.bin
*.safetensors
*.part
*.candidate
~$*.xlsx

